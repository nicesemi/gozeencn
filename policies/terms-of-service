  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // This script targets all jump links on the page
    const jumpLinks = document.querySelectorAll('a[href^="#"]');

    jumpLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        let targetId = this.getAttribute('href');
        // Ensure it's a link to an element on the page
        if (targetId.length > 1 && document.querySelector(targetId)) {
          e.preventDefault();

          const targetElement = document.querySelector(targetId);

          // Get the header height from our CSS variable
          const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerHeight;

          // Manually scroll to the calculated position
          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth"
          });
        }
      });
    });
  });
</script>

